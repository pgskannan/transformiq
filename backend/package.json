{
  "name": "@transformiq/backend",
  "version": "0.1.0",
  "private": true,
  "description": "TransformIQ API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --coverage --runInBand",
    "lint": "eslint src db --ext .ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:codegen": "kysely-codegen --dialect postgres --url \"$DATABASE_URL\" --out-file db/types.ts"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.0.0",
    "@google-cloud/secret-manager": "^7.0.0",
    "@google-cloud/storage": "^7.22.0",
    "chardet": "^2.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "kysely": "^0.28.17",
    "multer": "^2.2.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.20.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
