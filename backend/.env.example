# Copy to .env for local development. Never commit a real .env file (see .gitignore).

# Local Postgres (docker-compose) or your own local instance.
# transformiq_app is a least-privilege role (see db/migrations/0004_least_privilege_app_role.sql)
# — it cannot UPDATE/DELETE audit_events and cannot CREATE ROLE. The app connects as this role.
DATABASE_URL=postgresql://transformiq_app:transformiq_dev_only@localhost:5432/transformiq?schema=public

# Migrations need DDL/role-management privilege the app role doesn't have — they run as the
# schema-owning role instead. Only used by `npm run db:migrate`, never by the running app.
MIGRATIONS_DATABASE_URL=postgresql://transformiq:transformiq_dev_only@localhost:5432/transformiq?schema=public

PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Dev-only JWT signing secret (src/middleware/auth.ts). Used only when OIDC_JWKS_URI is unset.
DEV_JWT_SECRET=local-dev-only-not-for-production

# Shared secret required on POST /v1/tenants (src/middleware/rbac.ts requirePlatformAdmin).
# Tenant creation is a platform-level operation, not authorizable by any tenant-scoped role
# (TQ-011). Generate a real random value for anything beyond local dev.
PLATFORM_ADMIN_API_KEY=local-dev-platform-admin-key

# Set these once a real OIDC provider (e.g. GCP Identity Platform) is configured (TQ-006):
# OIDC_JWKS_URI=
# JWT_ISSUER=

# Set this once a real GCP project is available (TQ-001, TQ-005, TQ-079) — switches
# src/lib/secrets.ts to Secret Manager:
# GCP_PROJECT_ID=

# Gemini API key (src/lib/vertexAI.ts, via Google's Genkit framework) — powers the AI-assisted
# semantic type resolution second pass (TQ-039/040, src/lib/semantics/aiResolver.ts). Get one
# free at https://aistudio.google.com/apikey. Locally this is read straight from the
# environment (src/lib/secrets.ts); in a real GCP deployment set it as a Secret Manager secret
# named GEMINI_API_KEY instead and leave this unset. Without it, resolveAmbiguousSemanticType()
# degrades to returning no suggestion rather than failing the profiling job — the deterministic
# pipeline works with or without this key.
# GEMINI_API_KEY=
# Optional: override the default model (gemini-3.6-flash — see vertexAI.ts).
# GEMINI_MODEL=
