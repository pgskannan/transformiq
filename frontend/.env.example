VITE_API_BASE_URL=http://localhost:8080

# Dev-only: must match backend's PLATFORM_ADMIN_API_KEY. Only read by
# src/pages/DevBootstrapTenant.tsx, which is compiled out of production builds
# (see the import.meta.env.DEV guard in App.tsx). Never set this in a real deployment's
# frontend env — a real deployment provisions tenants out-of-band, not from a browser.
VITE_DEV_PLATFORM_ADMIN_KEY=local-dev-platform-admin-key
